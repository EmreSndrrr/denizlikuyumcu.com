# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the checked-in template — it has no real secrets, just docs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (local/personal overrides, not shared project config)
.claude/settings.local.json

# impeccable skill (local consent + cache; config.json is shared and tracked)
.impeccable/config.local.json
.impeccable/hook.cache.json

# python bytecode cache (vendored skill scripts)
__pycache__/
*.pyc

# claude-seo eklentisi buraya (proje köküne) klonlanmış — kendi git
# geçmişi olan ayrı bir araç deposu, proje kaynak kodunun parçası değil.
claude-seo/
